# Beancount Studio API — copy to .env and adjust. All variables are prefixed BS_.

# Where ledgers (git repos), uploads and the SQLite database live.
BS_DATA_DIR=./data
# Optional: use PostgreSQL instead of SQLite, e.g. postgresql+asyncpg://user:pass@db:5432/studio
BS_DATABASE_URL=

# Public URL of the web app (used in emails) and the origins allowed to call the API directly.
BS_PUBLIC_URL=http://localhost:3000
BS_CORS_ORIGINS=http://localhost:3000

# Long random string; used to sign password-reset tokens.
BS_SECRET_KEY=change-me
# Set to false after you created your account to keep the instance private.
BS_ALLOW_SIGNUP=true
# Set to true when the app is served over HTTPS.
BS_COOKIE_SECURE=false

# AI assistant (optional). Pick one provider; leave both empty to disable the assistant,
# receipt scanning and AI categorisation.
#
# 1) Anthropic (official SDK):
BS_ANTHROPIC_API_KEY=
#
# 2) Any OpenAI-compatible server with tool calling — Ollama, vLLM, LM Studio, llama.cpp,
#    OpenRouter, Groq, ... Set the base URL, the model name, and (if required) a key.
#    Ollama example: BS_OPENAI_BASE_URL=http://localhost:11434/v1  BS_AI_MODEL=qwen3:14b
BS_OPENAI_BASE_URL=
BS_OPENAI_API_KEY=
#
# "auto" prefers Anthropic when its key is set; force one with anthropic|openai, or "disabled".
BS_AI_PROVIDER=auto
# Chat model (default claude-opus-5-5 on Anthropic; required for OpenAI-compatible servers).
BS_AI_MODEL=
# Model for receipt extraction and categorisation (defaults to BS_AI_MODEL).
BS_AI_FAST_MODEL=

# Password-reset email (optional). Leave BS_SMTP_HOST empty to disable.
BS_SMTP_HOST=
BS_SMTP_PORT=587
BS_SMTP_USER=
BS_SMTP_PASSWORD=
BS_SMTP_FROM=Beancount Studio <noreply@example.com>

BS_LOG_LEVEL=INFO
