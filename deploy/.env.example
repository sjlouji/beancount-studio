# Host name Caddy should serve (it obtains a TLS certificate automatically).
# For a local HTTP-only trial use docker-compose.local.yml instead (see README).
DOMAIN=studio.example.com
BS_PUBLIC_URL=https://studio.example.com
BS_COOKIE_SECURE=true

# Required: a long random string (e.g. `openssl rand -hex 32`).
BS_SECRET_KEY=change-me

# After you created your own account, set this to false to keep the instance private.
BS_ALLOW_SIGNUP=true

# Optional: AI assistant, receipt scanning and AI categorisation. Pick ONE provider.
#
# a) Anthropic:
BS_ANTHROPIC_API_KEY=
#
# b) Open-source / self-hosted models through any OpenAI-compatible server with tool calling
#    (Ollama, vLLM, LM Studio, llama.cpp, OpenRouter, Groq, ...).
#    Bundled Ollama: start with `docker compose --profile ollama up -d`, then set
#      BS_OPENAI_BASE_URL=http://ollama:11434/v1
#      BS_AI_MODEL=qwen3:14b          # any tool-capable model; pull it once with
#                                     # `docker compose exec ollama ollama pull qwen3:14b`
#    External server: BS_OPENAI_BASE_URL=https://openrouter.ai/api/v1 and BS_OPENAI_API_KEY=...
BS_OPENAI_BASE_URL=
BS_OPENAI_API_KEY=
#
# auto = Anthropic when its key is set, else the OpenAI-compatible server. Or: anthropic | openai | disabled
BS_AI_PROVIDER=auto
# Chat model. Defaults to claude-opus-5-5 on Anthropic; required for OpenAI-compatible servers.
BS_AI_MODEL=
# Receipt extraction and categorisation model (defaults to BS_AI_MODEL). Needs vision for receipts.
BS_AI_FAST_MODEL=

# Optional: password-reset email.
BS_SMTP_HOST=
BS_SMTP_PORT=587
BS_SMTP_USER=
BS_SMTP_PASSWORD=
BS_SMTP_FROM=Beancount Studio <noreply@studio.example.com>
